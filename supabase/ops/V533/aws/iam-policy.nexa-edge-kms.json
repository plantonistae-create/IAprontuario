{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "WrapUnwrapOnThisKeyOnly",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:kms:sa-east-1:<ACCOUNT_ID>:key/<KEY_ID>",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "sa-east-1"
        },
        "Bool": {
          "aws:SecureTransport": "true"
        },
        "Null": {
          "kms:EncryptionContext:nexa_aad_sha256": "false"
        },
        "ForAllValues:StringEquals": {
          "kms:EncryptionContextKeys": [
            "nexa_aad_sha256"
          ]
        }
      }
    },
    {
      "Sid": "DenyAnyOtherKeyOrAction",
      "Effect": "Deny",
      "NotAction": [
        "kms:Encrypt",
        "kms:Decrypt"
      ],
      "Resource": "*"
    },
    {
      "Sid": "DenyCryptoOnAnyOtherKey",
      "Effect": "Deny",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt",
        "kms:ReEncrypt*",
        "kms:GenerateDataKey*",
        "kms:GenerateDataKeyPair*",
        "kms:GenerateDataKeyWithoutPlaintext",
        "kms:GenerateMac",
        "kms:VerifyMac",
        "kms:Sign",
        "kms:Verify",
        "kms:DeriveSharedSecret"
      ],
      "NotResource": "arn:aws:kms:sa-east-1:<ACCOUNT_ID>:key/<KEY_ID>"
    }
  ]
}
{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "NexaAudioBackupWrapUnwrapOnly",
      "Effect": "Allow",
      "Action": [
        "kms:Encrypt",
        "kms:Decrypt"
      ],
      "Resource": "arn:aws:kms:sa-east-1:<ACCOUNT_ID>:key/<KEY_ID>",
      "Condition": {
        "StringEquals": {
          "aws:RequestedRegion": "sa-east-1"
        },
        "Bool": {
          "aws:SecureTransport": "true"
        },
        "StringLike": {
          "kms:EncryptionContext:nexa_aad_sha256": "*"
        }
      }
    }
  ]
}